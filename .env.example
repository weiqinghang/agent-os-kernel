# Optional LLM (if unset, kernel uses deterministic stub that still calls DAS)
MODEL_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=grok-2-latest

# HITL: 1 = auto-approve outline/segment/final (default for overnight POC)
HITL_AUTO=1

# Ports
KERNEL_HOST=127.0.0.1
KERNEL_PORT=8787
FAKE_DAS_HOST=127.0.0.1
FAKE_DAS_PORT=8788
FAKE_DAS_URL=http://127.0.0.1:8788
