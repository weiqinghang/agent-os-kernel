# Optional LLM (if unset, kernel uses deterministic stub that still calls DAS)
MODEL_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=grok-2-latest

# HITL: 1 = auto-approve outline/segment/final (default for overnight POC)
HITL_AUTO=1

# Ports
KERNEL_HOST=127.0.0.1
KERNEL_PORT=8787
FAKE_DAS_HOST=127.0.0.1
FAKE_DAS_PORT=8788
# Base URL only. Real MCP is DAS_MCP_URL (.../api/mcp), not this path + /mcp.
FAKE_DAS_URL=http://127.0.0.1:8788

# Real DAS (default start). Token lives in gitignored data/das-local.env — do not commit it.
# DAS_MCP_URL=http://127.0.0.1:8788/api/mcp
# DAS_MCP_AUTH_TOKEN=
# DAS_HEALTH_URL=http://127.0.0.1:8788/health
# DAS_DATASET_ID=ecommerce_sales_v2

# Set to 1 to boot services/fake_das instead of /workspace/dataset-analysis-service.
# USE_FAKE_DAS=0
